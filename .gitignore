# Godot 4+ specific ignores
.godot/
/android/

# 本机探针/截图/日志：验收证据，但进版本库只会把仓库撑大、也没人 review 二进制
.probe/
_probe/
_check/
_test_*.txt
*.stdout.log
*.stderr.log
*.log

# 验收截图 / 临时 QA 产物（每次跑都会重出一批，需要留档的放 Documents/图/）
_qa/
# VAT 烘焙产物：由 Tools/烘焙VAT.gd 从 GLB 生成，单件 3~15MB，不进库（一条命令可重建）
Content/art/VAT/

# 引擎缓存目录（Godot 自己写的 app_userdata 链接，不是工程内容）
Godot/

# 显卡驱动崩溃日志（本机被驱动创建，不属于工程）
NVIDIA Corporation/


# 根目录探针截图的孤儿 .import（源 png 已删）
/_检查_*.png.import

# Blender QC 对照图（每跑一次 --qc 都会重出一批）
Tools/建模/v3/qc/
Tools/建模/v3/*.glb
Tools/建模/v6/qc/
Tools/建模/v6/*.log

# Python 缓存（各版本目录都会生成）
__pycache__/

# 本地回滚备份（不含交付物，仅本次会话临时备份旧语音）
_backup/

# 四季演示图（Tools/生成四季演示图.gd 现场生成，只用来截屏验收）
Content/maps/_四季演示.tres

# 地图编辑器的运行时产物（自动保存 / 测试临时图 / 最近列表）：本机用，不进库
Content/maps/_自动保存.tres
Content/maps/_测试地图.tres
Content/maps/_最近地图.cfg
Content/maps/_编辑器链路自检.tres

# WorkBuddy agent 元文件（.workbuddy/memory 等）：本机工作记录，不属于工程内容
.workbuddy/
# 测试模式的隔离存档（run-game --check/--simulate/--shot 写这里）
.test_profile/
# 发行/演示副本（脚本生成，不进库）
dist/

# 合成音效临时探针（子代理/调试用）
.synth_tmp/

# .NET 构建产物（dotnet build 生成）
**/bin/
**/obj/
