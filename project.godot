; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="战争原岛"
config/description="类魔兽争霸3 的 3D 即时战略（GDScript 全手写，美术由 Blender 程序化生成）"
config/version="2.0.0"
run/main_scene="res://Screens/scenes/战役.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

App="*res://Engine/boot/app.gd"
Keys="*res://Engine/util/asset_keys.gd"
I18n="*res://Engine/i18n/i18n_service.gd"
SaveSvc="*res://Engine/save/save_service.gd"
AudioSvc="*res://Engine/audio/audio_service.gd"
Platform="*res://Engine/platform/platform_service.gd"
DbgBridge="*res://Engine/debug/debug_bridge.gd"

[debug]

file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="战争原岛"

[editor_plugins]

enabled=PackedStringArray("res://addons/war_island_editor/plugin.cfg", "res://addons/map_shell_editor/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.42, 0.52, 0.6, 1)
