@tool
class_name RtsConst
extends RefCounted
## 全局常量表：枚举、层、字符串键。
## 之所以单独放一个文件，是因为这些枚举被 单位/战斗/AI/界面/寻路 全都要用，
## 散落各处会导致类型不一致。**只放枚举与固定键，不放可调数值**（数值去 Cfg）。

# ---------------------------------------------------------------------------
# 单位状态（RtsUnit.state）
# ---------------------------------------------------------------------------
enum State {
	IDLE = 0,      ## 待机
	MOVE = 1,      ## 移动
	ATTACK = 2,    ## 攻击
	GATHER = 3,    ## 采集
	BUILD = 4,     ## 建造
	DEAD = 5,      ## 死亡（等待移除）
	CAST = 6,      ## 施法
	RETURN = 7,    ## 搬运资源返回
}

# ---------------------------------------------------------------------------
# 指令类型（CommandSystem → RtsUnit）
# ---------------------------------------------------------------------------
enum Order {
	NONE = 0,
	MOVE = 1,          ## 移动到点
	ATTACK = 2,        ## 攻击指定目标
	ATTACK_MOVE = 3,   ## 攻击移动：路上遇敌就打
	STOP = 4,
	HOLD = 5,          ## 原地警戒
	GATHER = 6,        ## 采集指定资源点
	BUILD = 7,         ## 建造指定建筑
	CAST = 8,          ## 释放技能
	RETURN_RES = 9,    ## 返回资源交汇点
}

# ---------------------------------------------------------------------------
# 伤害类型 / 护甲类型
# ---------------------------------------------------------------------------
enum DamageType {
	NORMAL = 0,   ## 普通（近战）
	PIERCE = 1,   ## 穿刺（弓箭）
	MAGIC = 2,    ## 魔法
	SIEGE = 3,    ## 攻城
}

enum ArmorType {
	LIGHT = 0,      ## 轻甲
	HEAVY = 1,      ## 重甲
	FORTIFIED = 2,  ## 城甲
	NONE = 3,       ## 无甲
}

# ---------------------------------------------------------------------------
# 单位大类
# ---------------------------------------------------------------------------
enum Kind {
	UNIT = 0,
	BUILDING = 1,
	HARVESTABLE = 2,
}

# ---------------------------------------------------------------------------
# 动画套件类型（决定 ProcAnim 用哪套动作曲线）
# ---------------------------------------------------------------------------
enum AnimSet {
	WORKER = 0,
	MELEE = 1,
	ARCHER = 2,
	MAGE = 3,
	CIVIC_BUILDING = 4,
	MILITARY_BUILDING = 5,
	TOWER = 6,
	TREE = 7,
	ROCK = 8,
	GOLD_MINE = 9,
}

# ---------------------------------------------------------------------------
# 阵营索引
# ---------------------------------------------------------------------------
enum Faction {
	PLAYER = 0,
	ENEMY = 1,
	NEUTRAL = 2,
}

# ---------------------------------------------------------------------------
# 可采集资源种类
# ---------------------------------------------------------------------------
enum Harvest {
	GOLD = 0,
	WOOD = 1,
}

# ---------------------------------------------------------------------------
# 投射物种类
# ---------------------------------------------------------------------------
enum Projectile {
	NONE = 0,
	ARROW = 1,
	FIREBOLT = 2,
}

# ---------------------------------------------------------------------------
# 游戏中后期阶段（游戏自动加载体）
# ---------------------------------------------------------------------------
enum Phase {
	PREPARE = 0,
	RUNNING = 1,
	VICTORY = 2,
	DEFEAT = 3,
}
