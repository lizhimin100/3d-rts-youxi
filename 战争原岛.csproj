<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!--
    战争原岛 · Godot 宿主工程（只放表现 + 适配）

    · 真正的规则在 Model/WarIsland.Model.csproj（纯 C#，零 Godot）；
    · 这里用 ProjectReference 引进来，只编 Screens/ 下的桥与编辑器脚本；
    · Model/**/*.cs 必须从本工程排除，否则会被编两遍（类型冲突）。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>战争原岛</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Model/**/*.cs" />
    <Compile Remove="dist/**/*.cs" />
    <Compile Remove=".godot/**/*.cs" />
    <!-- _qa 是本地跑分/探针目录（已 gitignore）：里面的临时 C# harness 不能进宿主工程 -->
    <Compile Remove="_qa/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Model/WarIsland.Model.csproj" />
  </ItemGroup>

</Project>
